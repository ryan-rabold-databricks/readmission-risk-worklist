DATABRICKS_HOST=https://...
DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id
PGDATABASE=your_postgres_databaseName
LAKEBASE_ENDPOINT=your_postgres_endpointPath
PGHOST=your_postgres_host
PGPORT=5432
PGSSLMODE=require
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=dev-readmission-worklist
FLASK_RUN_HOST=0.0.0.0
# Set by the bundle (resources/readmission_worklist_app.app.yml) when deployed
READMIT_ENV=dev
READMIT_CATALOG=your_catalog
READMIT_PROGRAM_GO_LIVE=2026-05-01
READMIT_AVG_READMISSION_COST=15000
READMIT_LEADERSHIP_GROUP=care_mgmt_leadership
# Local development only: stands in for the x-forwarded-email header
READMIT_DEV_USER_EMAIL=you@example.com
